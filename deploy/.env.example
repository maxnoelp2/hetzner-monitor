# Copy to deploy/.env and adjust. Never commit deploy/.env.
# Placeholder values only.

# Postgres password used by both containers. CHANGE for anything that is not a local test setup.
HM_POSTGRES_PASSWORD=change-me
# Host ports (bound to 127.0.0.1 only).
HM_POSTGRES_PORT=55432
HM_PORT=8080

# Master key for encrypting Hetzner tokens at rest (32 bytes, base64). REQUIRED.
# Generate:  docker compose -f deploy/docker-compose.yml run --rm --no-deps app master-key generate
#   (or:     openssl rand -base64 32)
# Losing it makes all stored tokens unrecoverable — back it up like a password.
HM_MASTER_KEY=

HM_MODE=all
HM_LOG=info
